{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://purple1-api.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://purple1-api.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://purple1-api.onrender.com/admin/:path*"
    },
    {
      "source": "/img/uploads/:path*",
      "destination": "https://purple1-api.onrender.com/img/uploads/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}